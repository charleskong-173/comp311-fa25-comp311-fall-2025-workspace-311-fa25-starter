0x90D194B5 0xB005500E 0b0010 0x40D6E4C3

# SUB tests (ALUOperation = 0110)
0x39332544 0x0435FCAD 0b0110 0x34FD2897
0x59286AB1 0x221FB76C 0b0110 0x3708B345
0xECD55935 0x248C5A4B 0b0110 0xC848FEEA
0x902A9525 0xE5454D48 0b0110 0xAAE547DD
0x8211036A 0x7B13890A 0b0110 0x06FD7A60
0x5FE15DBE 0x8934B9B1 0b0110 0xD6ACA40D

# AND tests (ALUOperation = 0000)
