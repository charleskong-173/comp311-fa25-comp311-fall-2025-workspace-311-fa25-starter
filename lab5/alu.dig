0x4152A22D 0x22042121 0b0111 0x00000000   # both positive, A &gt; B
0x84893212 0x0994AD1A 0b0111 0x00000001   # A negative, B positive
0x90A8826C 0x112109FB 0b0111 0x00000001   # A negative, B positive
0x5210C12D 0x3D04ABBC 0b0111 0x00000000   # both positive, A &gt; B
0x90D194B5 0xB005500E 0b0111 0x00000001   # both negative, A &lt; B</dataString>
